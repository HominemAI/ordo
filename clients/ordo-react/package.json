{
  "name": "@hominemai/ordo-react",
  "version": "0.5.0",
  "description": "Headless React runtime over an Ordo interface descriptor (ordo.interface/1).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HominemAI/ordo.git",
    "directory": "clients/ordo-react"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build && tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "@hominemai/ordo-sdk": ">=0.5.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@hominemai/ordo-sdk": "file:../ordo-sdk",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-test-renderer": "^18.3.1",
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  }
}
