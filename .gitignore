target/

# `wasm-pack`'s output. `crates/ordo-wasm/demo.html` is generated FROM it and
# is committed — that one file is the deliverable and is what gets published;
# the intermediate `pkg/` is rebuilt by `scripts/build-wasm.sh`.
crates/ordo-wasm/pkg/

# Agent worktrees are transient checkouts, not repo content.
.claude/worktrees/

# `ordo dev` puts its disposable Postgres cluster and generated output here,
# beside the sources it is watching. Never repo content.
.ordo/

# Editor scratch. `crates/ordo-host/src/.runtime.rs.swp` was committed by
# accident in `65435ab` on 2026-09-25 and was tracked for two days, so the
# pattern is here rather than left to the next person to notice.
*.swp
*.swo

# The board exports through a temp file.
docs/*.jsonl.tmp
scripts/__pycache__/

# The compose example's secrets (scripts/make-secrets.sh).
docker/secrets/

# macOS folder metadata.
.DS_Store

# Working notes and review-run output that name local folders. The review
# reports themselves are regenerated by the design-review pipeline.
compact.md
review/history/
review/report.json
review/report.prev.json
review/report.html
