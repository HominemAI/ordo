# note_viewer. Reads the notes notes v2 (examples/notes-v2) holds, through
# notes v2's door. Read-only: nothing here writes into notes v2, and no row
# of it is kept here.
#
# `peer notes` is a local nickname for notes v2. Its door is the setting
# ORDO_PEER_NOTES_URL. The block lists the ops of notes v2 this deployment
# calls; notes v2's `grant note_viewer` must open each, and the apply checks
# it there. notes v2 refuses every other op.
#
# Both apps sign people in through the identity service, so one person is
# one subject in both. A read made for a person signed in here is made for
# the same person there, and notes v2's own acl decides what they see.

domain noteviewer @ 0.2.0

peer notes {
  myNotes
  publicNotes
}

# The public list: notes v2's `publicNotes`, the notes tagged `public`. A
# table named like an op of the block is read by that op. No guard, so a
# public op may read it; called with nobody signed in, it is asked as this
# deployment itself.
external published from notes.publicNotes shared {
  public
  id: text <- id
  title: text <- title
  body: text <- body
  created: datetime <- created
}

# Every note the signed-in person may read in notes v2: its `myNotes`,
# asked for that person. notes v2's acl decides which.
external entries from notes.myNotes shared {
  id: text <- id
  title: text <- title
  body: text <- body
  tags: json <- tags
  created: datetime <- created
}

# Anyone, with no token.
op publicNotes public =
  published[id, title, body, created]
  sort -created
  take 100

# Every note the signed-in person may read in notes v2.
op myNotes =
  entries[id, title, body, tags, created]
  sort -created
  take 100
