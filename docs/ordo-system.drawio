        </mxCell>
        <mxCell id="t1b" value="Status: ~60 commits, CI green, tokio-postgres pooled in ordo-exec, `ordo` binary checks and plans. 337 tests. Green = code on disk and passing tests. Amber = real code but non-durable / boundary only. Red = does not exist." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1100" height="30" as="geometry" />
