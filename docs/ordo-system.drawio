        <mxCell id="ct1" value="Ordo — deploy time: source text to registered operations" style="text;html=1;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ct2" value="This is the `ordo plan &amp;amp;&amp;amp; ordo apply` path from the README. All read/write stages execute; `ordo check` and `ordo plan` invoke them." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1000" height="30" as="geometry" />
        </mxCell>

        <mxCell id="c_src" value="domain source&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;entity · op · routine · route&lt;br&gt;closed grammar, one spelling per concept&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="190" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c_syn" value="ordo-syntax&lt;br&gt;&lt;b&gt;✅ EXISTS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;lexer · AST · parser&lt;br&gt;&lt;b&gt;+ declarations &amp;amp; pipelines&lt;/b&gt;&lt;br&gt;43 tests&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="310" y="180" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c_sch" value="ordo-schema&lt;br&gt;&lt;b&gt;✅ P2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;entity graph, implicit id/rev/depth, refs, ownership, tree, sealed marks, DDL&lt;br&gt;&lt;b&gt;acl derivation and the effective-guard table execute&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="590" y="180" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c_sem" value="ordo-sema&lt;br&gt;&lt;b&gt;✅ P3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;binder, composition inlining, post-take subquery, joins&lt;br&gt;&lt;b&gt;guard inlining executes&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="870" y="180" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c_pln" value="ordo-plan&lt;br&gt;&lt;b&gt;✅ P4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;pipeline → PostgreSQL SELECT&lt;br&gt;total ordering guaranteed&lt;br&gt;&lt;b&gt;cost classes and the registration gates enforce&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1150" y="180" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c_art" value="ordo-artifact&lt;br&gt;&lt;b&gt;❌ P4/P5&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;registration metadata:&lt;br&gt;mode label · cost class&lt;br&gt;scope manifest · effective guard set&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1150" y="420" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c_reg" value="OpRegistry&lt;br&gt;&lt;b&gt;⚠ SHAPE EXISTS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;MapRegistry · RegistryHandle&lt;br&gt;hot-swap under RwLock&lt;br&gt;&lt;b&gt;nothing populates it but tests&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="870" y="420" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c_out" value="Everything derived at deploy — &quot;~70 lines, working app&quot;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;DDL: generated.&lt;/b&gt; HTTP op surface · migrations · permissions surface&lt;br&gt;audit machinery · generated UI · routines · notification routes: none of these&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="470" y="410" width="330" height="140" as="geometry" />
        </mxCell>

        <mxCell id="c_cli" value="ordo-cli&lt;br&gt;&lt;b&gt;✅ P7 — THE CLI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;`ordo check` · `ordo plan` · `ordo apply` · `ordo dev`&lt;br&gt;&lt;br&gt;&lt;b&gt;The `ordo` binary exists:&lt;br&gt;check and plan.&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="410" width="330" height="140" as="geometry" />
        </mxCell>

        <mxCell id="c_conf" value="ordo-conformance  ⚠ P6 SLICE — the release gate, partly standing&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Runs §2.4 stages parse → compile → execute → compare against a seeded PostgreSQL 17 cluster.&lt;br&gt;&lt;b&gt;337 tests green; guards conformance and the visibility matrix execute&lt;/b&gt; Expected rows are the corpus document's, not the author's.&lt;br&gt;Still absent: the other 114 cases, all ~87 guard cases (nothing to guard), and golden SQL snapshots.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacingLeft=16;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="620" width="900" height="120" as="geometry" />
        </mxCell>

        <mxCell id="ce1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="c_src" target="c_syn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="c_syn" target="c_sch"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="c_sch" target="c_sem"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="c_sem" target="c_pln"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="c_pln" target="c_art"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="c_art" target="c_reg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="c_reg" target="c_out"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce8" value="drives the whole pipeline" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#b85450;fontSize=10;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="c_cli" target="c_syn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce9" value="gates release" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="c_conf" target="c_out"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="c_note" value="&lt;b&gt;The authorization gap, stated precisely&lt;/b&gt;&lt;br&gt;&lt;br&gt;`acl`, `access`, and `unguarded` &lt;b&gt;lex&lt;/b&gt; — the tokens are recognised. The parser has &lt;b&gt;no guard productions&lt;/b&gt;, so they never bind. There is no schema graph to derive `acl` into, no binder to inline a guard, and no executor to inline it into. The error code `access_guard` exists in ordo-api; nothing can raise it.&lt;br&gt;&lt;br&gt;Consequence: every row-level authorization example in the docs is a specification, not behaviour. That is finding &lt;b&gt;X-001, still open&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f0e8;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="370" height="240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

