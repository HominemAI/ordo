routine meterAnomaly in estate {
  trigger when estate.readings.created debounce 5m
  run($today: date) unguarded:
    let baseline =
      readings
        reduce { a: avg value }
    readings(value > 3 * baseline.a)[id, value, meterId: meter.id, meter.kind, meter.unit.name]
    each ->
      set alerts { kind: "meter", key: "meter:" + meterId, severity: "warning", status: "active", raised: $today, title: kind + " anomaly in " + name }
}
