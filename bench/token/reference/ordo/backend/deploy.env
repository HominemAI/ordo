# The app's choices for its deployment. The bench sets the machine.
# A person who signs in and holds no team of their own gets one, as owner.
ORDO_AUTH_PROVISIONING=auto-onboard
ORDO_PROVISION_SELF_SERVE=on-signup
# An emailed code proves no passkey presence, and this app has no passkeys.
# So inviting and removing people ask for no touch. The door still keeps
# them for owners.
ORDO_STEP_UP_EXEMPT_OPS=std.space.invite,std.space.remove,std.space.create
