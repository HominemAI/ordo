external accounts (key: acct) from crm.accounts shared {
  id: uuid <- "ref"
  label: text <- "label"
}

external customers from crm.customers shared {
  id <- "customer_id"
  name: text public <- "full_name"
  email: text? <- "email"
  account -> accounts? <- "account_id"
  public
  access read open
}

external tags from "Legacy"."Tag Rows" shared {
  id: text <- "Code"
  title: text <- "Title"
}
