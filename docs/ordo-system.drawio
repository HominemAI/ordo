        <mxCell id="panelA" value="ordo-api  ·  HTTP surface  ·  EXISTS (53 tests + 42 integration)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=14;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="280" y="110" width="560" height="750" as="geometry" />
        </mxCell>

        <mxCell id="client" value="Client / SDK&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;POST /op/{name}&lt;br&gt;GET /op/{name}?live=1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="1 · Registry lookup&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;/op/{name} → OpSpec · registry.rs · hot-swappable RegistryHandle&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="150" width="500" height="52" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2 · Method enforcement&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;GET=read · POST=write · DELETE=pure-delete → mismatch is 405 method_mismatch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="216" width="500" height="52" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3 · Envelope split&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;closed key set — no free-form query text ever reaches the wire&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="282" width="500" height="52" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4 · Space bind&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;$space or X-Ordo-Space → SpaceId · bound BEFORE the access check (SH-19)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="348" width="500" height="52" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5 · Access check — &quot;the door&quot;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;delegated across the AccessChecker trait →&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="414" width="500" height="52" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="6 · Param bind &amp;amp; coercion&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;bind.rs — typed params from the declared ParamSpec, nothing else admitted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="480" width="500" height="52" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="7 · Refinement validation&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;refine.rs — tiered caller-supplied narrowing, still inside the declared scope&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="546" width="500" height="52" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="8 · Cursor decode&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;page.rs + mac.rs — MAC-authenticated, principal-bound page cursors (SH-6)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="612" width="500" height="52" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="9 · Idempotency claim&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;idempotency.rs — reservation, request fingerprint, replay of stored response&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="678" width="500" height="52" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="10 · Execute prepared plan&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;OpExecutor trait — implemented for real by ordo-host over the compiler + ordo-exec&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="744" width="500" height="52" as="geometry" />
        </mxCell>

        <mxCell id="panelB" value="ordo-identity · EXISTS (17 unit + 1111 lines of tests)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="900" y="330" width="440" height="250" as="geometry" />
        </mxCell>
        <mxCell id="acc0" value="AccessEngine::check() — one check at the door" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="920" y="368" width="400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="acc1" value="① membership role in this space" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="414" width="400" height="32" as="geometry" />
        </mxCell>
        <mxCell id="acc2" value="② per-space access profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="452" width="400" height="32" as="geometry" />
        </mxCell>
        <mxCell id="acc3" value="③ capability allowlist + step-up freshness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="490" width="400" height="32" as="geometry" />
        </mxCell>
        <mxCell id="acc4" value="Decides WHETHER the op runs. It does NOT decide which rows you see — that is row-level `acl` / guards — parse, bind, inline, and execute (X-001 closed)." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#9a6a00;" vertex="1" parent="1">
          <mxGeometry x="920" y="528" width="400" height="44" as="geometry" />
        </mxCell>

        <mxCell id="panelC" value="ordo-exec · PARTIAL (phase F5) — built" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=13;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="700" width="440" height="170" as="geometry" />
        </mxCell>
        <mxCell id="exec1" value="prepared plans · transactions · host-side sealed stages&lt;br&gt;chain append · triggers · job queue&lt;br&gt;&lt;br&gt;&lt;b&gt;This crate exists and does exactly that:&lt;/b&gt; pooled tokio-postgres, transaction seam, read executor with the venue gate, keyset paging, and single-transaction writes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="736" width="400" height="118" as="geometry" />
        </mxCell>

        <mxCell id="pg" value="PostgreSQL&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;the only mandatory stateful dependency&lt;br&gt;&lt;b&gt;WIRED — pooled tokio-postgres&lt;br&gt;is the read and write path&lt;/b&gt;&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1010" y="910" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="panelD" value="ordo-commandlog · PARTIAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="900" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cl1" value="CommandGroup → frozen canonical byte encoding → SHA-256 per-space hash chain&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;chain.rs — BTreeMap images, no floats, big-endian, length-prefixed UTF-8. Genesis prev = 32 zero bytes.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="938" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cl2" value="Store trait — checkpoints, revert planning&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;Groups append inside the write transaction.&lt;/b&gt; A durable Postgres-backed store is still owed.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="1008" width="520" height="60" as="geometry" />
        </mxCell>

        <mxCell id="bus" value="InvalidationBus&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;MemoryBus — broadcast channels per space.&lt;br&gt;Feeds SSE live queries (?live=1).&lt;br&gt;Single-process only.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="180" height="110" as="geometry" />
        </mxCell>

