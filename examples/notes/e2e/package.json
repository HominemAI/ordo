{
  "name": "ordo-notes-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end tests of the notes app: a throwaway stack (stack.sh) and Playwright flows against it.",
  "type": "module",
  "scripts": {
    "stack": "bash stack.sh",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:browser": "playwright test --project=browser",
    "report": "playwright show-report report/html",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
