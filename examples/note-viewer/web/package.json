{
  "name": "ordo-note-viewer-web",
  "version": "0.1.0",
  "private": true,
  "description": "The note_viewer page: notes v2's notes through a peer. React over @hominemai/ordo-sdk, served by Vite on http://localhost:5174.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
